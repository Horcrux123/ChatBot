# =============================================================
# ENVIRONMENT VARIABLES - ZOHO PROJECTS CHATBOT
# =============================================================

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# OAuth Redirect URI
ZOHO_REDIRECT_URI=http://localhost:8000/auth/callback

# Zoho Accounts URL (e.g., https://accounts.zoho.in or https://accounts.zoho.com)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Zoho Projects REST API URL base
ZOHO_API_BASE=https://projectsapi.zoho.com/restapi

# Gemini API Key (if using ChatGoogleGenerativeAI)
GEMINI_API_KEY=

# JWT Session encryption key
SECRET_KEY=your-random-secret-for-sessions

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./zoho_chatbot.db

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
