# =============================================================
# ENVIRONMENT VARIABLES - ZOHO PROJECTS CHATBOT
# Rename this file to '.env' and fill in your credential values.
# =============================================================

# Zoho API Console Credentials
# Create a Web Client at https://api-console.zoho.com/
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret

# OAuth Redirect URI (must match the authorized redirect URI registered in Zoho Console)
ZOHO_REDIRECT_URI=http://localhost:8000/auth/callback

# Zoho Accounts URL (varies by region e.g. https://accounts.zoho.eu or https://accounts.zoho.in)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Zoho Projects REST API URL base
ZOHO_API_BASE=https://projectsapi.zoho.com/restapi

# Anthropic API Key (required for LangGraph agents execution)
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# JWT Session encryption key (any random string, minimum 32 characters recommended)
SECRET_KEY=your-random-secret-for-sessions-change-me-locally-to-something-secure

# SQLite database connection URL (uses aiosqlite for async engine operation)
DATABASE_URL=sqlite+aiosqlite:///./zoho_chatbot.db

# Frontend Application URL (used for CORS and redirect configurations)
FRONTEND_URL=http://localhost:5173
